@startuml SGRH_UseCases
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseBorderColor #1e293b
skinparam usecaseBackgroundColor #f8fafc
skinparam usecaseFontSize 10
skinparam arrowColor #475569
skinparam actorBorderColor #0f172a
skinparam actorBackgroundColor #e2e8f0
skinparam actorFontSize 12
skinparam packageBorderColor #94a3b8

left to right direction

actor "Super Admin" as SA
actor "Admin RH"    as HR
actor "Professeur"  as PR
actor "Etudiant"    as ET

HR <|-- SA : generalisation

package "Authentification" {
  usecase "Se connecter"        as LOGIN
  usecase "Gerer profil"        as PROFILE
  usecase "Uploader signature"  as SIG_UP
  PROFILE <|-- SIG_UP : extends
}

package "Gestion Utilisateurs\net Employes" {
  usecase "Gerer utilisateurs"  as U_MGT
  usecase "Importer Excel"      as U_EXCEL
  usecase "Gerer employes"      as E_MGT
  usecase "Gerer departements"  as E_DEPT
  usecase "Autoriser signature" as E_CSIGN
  U_EXCEL ..> E_MGT : <<includes>>
}

package "Gestion Conges" {
  usecase "Demander conge"      as L_REQ
  usecase "Joindre justificatif" as L_ATT
  usecase "Consulter solde"     as L_BAL
  usecase "Approuver conge"     as L_APP
  usecase "Rejeter conge"       as L_REJ
  L_REQ <|-- L_ATT : extends
  L_APP ..> L_REQ  : <<includes>>
}

package "Documents et PDF" {
  usecase "Demander document"   as D_REQ
  usecase "Demande libre"       as D_FREE
  usecase "Approuver document"  as D_APP
  usecase "Telecharger PDF"     as D_DL
  usecase "Signer document"     as D_SIGN
  usecase "Voir doc signe"      as D_SADL
  usecase "Gerer modeles"       as D_TPL
  D_REQ  <|-- D_FREE : extends
  D_APP  ..> D_DL    : <<includes>>
  D_SIGN ..> D_APP   : <<includes>>
}

package "Ordres de Mission" {
  usecase "Demander mission"    as M_REQ
  usecase "Approuver mission"   as M_APP
  usecase "Generer PDF mission" as M_PDF
  M_APP ..> M_PDF : <<includes>>
  M_APP ..> M_REQ : <<includes>>
}

package "Evaluations et Promotions" {
  usecase "Auto-evaluation"     as EV_SELF
  usecase "Evaluer employe"     as EV_SUP
  usecase "Voir resultats"      as EV_VIEW
  usecase "Gerer promotions"    as PR_MGT
  usecase "Generer tableau"     as PR_TB
  EV_SUP ..> EV_SELF : <<includes>>
  PR_TB  ..> PR_MGT  : <<includes>>
}

package "Messagerie et Notifications" {
  usecase "Envoyer message"       as MG_S
  usecase "Creer conversation"    as MG_C
  usecase "Recevoir notification" as NT_R
  usecase "Envoyer broadcast"     as NT_B
  MG_S  ..> MG_C : <<includes>>
  NT_B  ..> NT_R : <<includes>>
}

package "Audit et Administration" {
  usecase "Journal audit"       as AD_L
  usecase "Gerer parametres"    as AD_P
  usecase "Dashboard"           as AD_D
}

' ══ RELATIONS ══

' Commun
ET --> LOGIN
PR --> LOGIN
HR --> LOGIN

' Etudiant
ET --> D_REQ
ET --> MG_S
ET --> NT_R

' Professeur
PR --> SIG_UP
PR --> L_REQ
PR --> L_BAL
PR --> D_REQ
PR --> D_SIGN
PR --> D_DL
PR --> M_REQ
PR --> EV_SELF
PR --> EV_VIEW
PR --> MG_S
PR --> NT_R

' Admin RH
HR --> U_MGT
HR --> U_EXCEL
HR --> E_DEPT
HR --> E_CSIGN
HR --> L_APP
HR --> L_REJ
HR --> D_APP
HR --> D_SADL
HR --> D_TPL
HR --> M_APP
HR --> EV_SUP
HR --> PR_MGT
HR --> NT_B

' Super Admin seulement
SA --> AD_L
SA --> AD_P
SA --> AD_D

@enduml
